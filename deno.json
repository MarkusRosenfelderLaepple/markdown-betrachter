{
  "name": "markdown-betrachter",
  "version": "0.1.0",
  "exports": "./main.ts",
  "nodeModulesDir": "auto",
  "exclude": [
    "ui",
    "tools",
    "dist-app",
    "node_modules"
  ],
  "tasks": {
    "start": "deno task build && open dist-app/Markdown-Betrachter.app",
    "build": "deno task ui:build && deno desktop -A --include ui/dist --output dist-app/Markdown-Betrachter.app main.ts",
    "icons": "cd tools && deno task icons",
    "api": "deno run -A main.ts",
    "ui:dev": "cd ui && deno task dev",
    "ui:build": "cd ui && deno task build",
    "test": "deno test -A",
    "install:all": "deno install && cd ui && deno install && cd ../tools && deno install",
    "check": "deno task check:server && deno task check:ui && deno task check:tools",
    "check:server": "deno fmt && deno lint && deno check main.ts src/ shared/ tests/",
    "check:ui": "cd ui && deno task check",
    "check:tools": "cd tools && deno task check",
    "install:macos": "deno task build && deno run -A scripts/macos-install.ts",
    "dmg": "deno task ui:build && deno desktop -A --include ui/dist --output dist-app/Markdown-Betrachter.dmg main.ts"
  },
  "imports": {
    "@hono/zod-validator": "jsr:@hono/zod-validator@^0.9.0",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/fs": "jsr:@std/fs@^1.0.24",
    "@std/http": "jsr:@std/http@^1.1.3",
    "@std/log": "jsr:@std/log@^0.224.14",
    "@std/path": "jsr:@std/path@^1.1.2",
    "@std/testing": "jsr:@std/testing@^1.0.20",
    "hono": "jsr:@hono/hono@^4.13.3",
    "hono/": "jsr:/@hono/hono@^4.13.3/",
    "zod": "jsr:@zod/zod@^4.4.3"
  },
  "compilerOptions": {
    "lib": [
      "deno.window",
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "strict": true
  },
  "compile": {
    "include": [
      "ui/dist"
    ]
  },
  "fmt": {
    "lineWidth": 110
  },
  "desktop": {
    "app": {
      "name": "Markdown-Betrachter",
      "identifier": "com.laepple.markdown-betrachter",
      "icons": {
        "macos": "./icons/icon.png",
        "windows": "./icons/icon.ico",
        "linux": "./icons/icon.png"
      }
    }
  }
}
